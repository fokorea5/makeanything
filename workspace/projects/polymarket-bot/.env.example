# =================================================================
# Polymarket 자동매매 봇 — 환경 변수 설정 파일
# 이 파일을 .env로 복사하고 실제 값을 채우세요:
#   cp .env.example .env
# =================================================================

# ===== 필수 (실거래 시) =====
# Polygon 개인키 (0x 접두어 포함)
POLY_PRIVATE_KEY=0xYourPolygonPrivateKey

# Polymarket CLOB API 자격증명
# https://polymarket.com 에서 발급
POLY_API_KEY=your-api-key
POLY_API_SECRET=your-api-secret
POLY_API_PASSPHRASE=your-api-passphrase

# 지갑 주소 (포지션 조회에 사용)
POLY_WALLET_ADDRESS=0xYourWalletAddress

# ===== 선택 (기본값 있음) =====

# 드라이런 모드 (true=가상, false=실거래)
# 기본값: true (안전 우선)
DRY_RUN=true

# 로그 레벨: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SQLite DB 파일 경로
DB_PATH=data/polymarket_bot.db

# 메인 루프 주기 (초)
# 기본값: 30초
CYCLE_INTERVAL=30
