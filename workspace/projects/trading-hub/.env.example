# Trading Hub 환경 변수 설정
# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.

# 서버 설정
HOST=0.0.0.0
PORT=8000

# DB 경로 (기본값: data/trading_hub.db)
# DATABASE_URL=sqlite:///./data/trading_hub.db

# 암호화 키 (Fernet.generate_key() 로 생성)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# 텔레그램 알림 설정
# BotFather에서 봇 생성 후 토큰 입력
TELEGRAM_BOT_TOKEN=
# getUpdates API로 chat_id 확인
TELEGRAM_CHAT_ID=

# 봇 설정
BOT_TICK_INTERVAL=10
WS_PUSH_INTERVAL=3
