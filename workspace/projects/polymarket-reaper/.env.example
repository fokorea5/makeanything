# === API 접속 ===
# Polygon 지갑 개인키
POLY_PRIVATE_KEY=0x...
# CLOB L2 API Key
POLY_API_KEY=
# CLOB L2 Secret
POLY_API_SECRET=
# CLOB L2 Passphrase
POLY_API_PASSPHRASE=
# 지갑 주소
POLY_WALLET_ADDRESS=0x...
# 0=EOA, 1=POLY_PROXY
POLY_SIGNATURE_TYPE=0
# POLY_PROXY일 때만 필요
POLY_FUNDER_ADDRESS=

# === 실행 모드 ===
# true: 드라이런(가상실행), false: 실거래
DRY_RUN=true
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# LIVE 모드 초기 bankroll (USDC). 0이면 Data API에서 자동 감지.
# Data API 연결 실패 시 이 값이 fallback으로 사용됩니다.
INITIAL_BANKROLL=0

# === Frequency Governor ===
# TURBO, NORMAL, STEALTH, AUTO
FREQUENCY_MODE=AUTO

# === Risk ===
# 연 5% (유지비용 계산용)
RISK_FREE_RATE=0.05
# 최소 순이익 USDC
MIN_PROFIT_THRESHOLD=0.50

# === 전략 토글 (1=활성, 0=비활성) ===
STRATEGY_AMBIGUITY=1
STRATEGY_ORACLE_FEAR=1
STRATEGY_CONTRARIAN=1
STRATEGY_CORRELATED=1
STRATEGY_LIQUIDITY_VACUUM=1
STRATEGY_COMPLETE_SET=1
